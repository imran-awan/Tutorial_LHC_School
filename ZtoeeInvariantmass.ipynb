      "source": [
        "import uproot\n",
        "import awkward as ak\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import vector\n",
        "\n",
        "vector.register_awkward()\n",
        "\n",
        "def get_dielectron_mass(file_path, is_mc=False):\n",
        "    tree = uproot.open(file_path)[\"Events\"]\n",
        "\n",
        "    # Define required branches\n",
        "    branches = [\"Electron_pt\", \"Electron_eta\", \"Electron_phi\", \"Electron_charge\", \"Electron_cutBased\"]\n",
        "    if is_mc:\n",
        "        branches.append(\"genWeight\")\n",
        "\n",
        "    events = tree.arrays(branches, library=\"ak\")\n",
        "\n",
        "    # Zip electron attributes into a single 4-vector collection, mass is in GeV\n",
        "    electrons = vector.zip({\n",
        "        \"pt\": events.Electron_pt,\n",
        "        \"eta\": events.Electron_eta,\n",
        "        \"phi\": events.Electron_phi,\n",
        "        \"mass\": 0.000511,\n",
        "        \"charge\": events.Electron_charge,\n",
        "        \"cutBased\": events.Electron_cutBased,\n",
        "    })\n",
        "\n",
        "    # Cut 1: At least 2 electrons\n",
        "    has_2e = ak.num(electrons) >= 2\n",
        "    electrons_2e = electrons[has_2e]\n",
        "\n",
        "    # Extract leading (0) and subleading (1) electrons safely\n",
        "    e1 = electrons_2e[:, 0]\n",
        "    e2 = electrons_2e[:, 1]\n",
        "\n",
        "    # Cut 2: Kinematics (pT > 25 GeV), Loose ID, Opposite Charge\n",
        "    pt_cut = (e1.pt > 25) & (e2.pt > 25)\n",
        "    os_cut = (e1.charge != e2.charge)\n",
        "    id_cut = (e1.cutBased >= 2) & (e2.cutBased >= 2)\n",
        "    selection = pt_cut & os_cut & id_cut\n",
        "\n",
        "    # Calculate invariant mass directly with vector arithmetic\n",
        "    e1_sel = e1[selection]\n",
        "    e2_sel = e2[selection]\n",
        "    m_ee = (e1_sel + e2_sel).mass\n",
        "\n",
        "    if is_mc:\n",
        "        weights = events.genWeight[has_2e][selection]\n",
        "        return m_ee, weights\n",
        "    return m_ee\n",
        "\n",
        "# Extract mass distributions\n",
        "print(\"Processing Real Collision Data...\")\n",
        "m_ee_data = get_dielectron_mass(\"sample.root\", is_mc=False)\n",
        "\n",
        "print(\"Processing Drell-Yan Monte Carlo...\")\n",
        "m_ee_mc, weights_mc = get_dielectron_mass(\"mc_sample.root\", is_mc=True)\n",
        "\n",
        "# Plotting Comparison\n",
        "plt.figure(figsize=(9, 6))\n",
        "\n",
        "# Plot Monte Carlo (Normalized shape as filled area)\n",
        "plt.hist(\n",
        "    m_ee_mc, bins=60, range=(60, 120), weights=weights_mc,\n",
        "    density=True, alpha=0.5, color='orange', label='Drell-Yan MC (DYJetsToLL)', edgecolor='darkorange'\n",
        ")\n",
        "\n",
        "# Plot Data (Normalized shape as points/error bars)\n",
        "counts_data, bin_edges = np.histogram(m_ee_data, bins=60, range=(60, 120))\n",
        "bin_centers = 0.5 * (bin_edges[1:] + bin_edges[:-1])\n",
        "norm_data = counts_data / np.sum(counts_data)\n",
        "\n",
        "plt.errorbar(\n",
        "    bin_centers, norm_data, yerr=np.sqrt(counts_data)/np.sum(counts_data),\n",
        "    fmt='o', color='black', markersize=5, label='Run 2016G Data'\n",
        ")\n",
        "\n",
        "plt.axvline(91.1876, color='red', linestyle='--', linewidth=1.5, label=\"PDG Z Mass (91.2 GeV)\")\n",
        "plt.title(r\"CMS Open Data (13 TeV) — Data vs. MC Comparison ($Z \\rightarrow e^+e^-$)\", fontsize=13)\n",
        "plt.xlabel(r\"Dielectron Invariant Mass $m_{ee}$ [GeV]\", fontsize=12)\n",
        "plt.ylabel(\"Normalized Unit Density\", fontsize=12)\n",
        "plt.grid(True, linestyle=\":\", alpha=0.6)\n",
        "plt.legend(fontsize=11)\n",
        "plt.show()",
        "print('created in colab')",
      ]
    },
