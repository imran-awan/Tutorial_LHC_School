      "source": [
        "import uproot\n",
        "import awkward as ak\n",
        "import matplotlib.pyplot as plt\n",
        "import vector\n",
        "\n",
        "vector.register_awkward()\n",
        "\n",
        "# 1. Open local NanoAOD ROOT file\n",
        "print(\"Opening sample.root...\")\n",
        "file = uproot.open(\"sample.root\")\n",
        "tree = file[\"Events\"] #Accessing contents,Now we want to actually access the object inside the file. You can do this just as you would to get an item in an array:\n",
        "\n",
        "# 2. Extract Electron branch collections\n",
        "electrons = tree.arrays(\n",
        "    [\"Electron_pt\", \"Electron_eta\", \"Electron_phi\", \"Electron_charge\", \"Electron_cutBased\"],\n",
        "    library=\"ak\"\n",
        ")\n",
        "\n",
        "# 3. Filter events with at least two electrons\n",
        "has_2e = ak.num(electrons.Electron_pt) >= 2\n",
        "events_2e = electrons[has_2e]\n",
        "\n",
        "# Extract leading two electrons by pT\n",
        "e1 = events_2e[:, 0]\n",
        "e2 = events_2e[:, 1]\n",
        "\n",
        "# 4. Selection cuts for Run 2 NanoAOD:\n",
        "# - pT > 25 GeV\n",
        "# - Opposite-sign charge (e+ e-)\n",
        "# - Cut-based ID >= 2 (Loose ID standard for CMS electrons)\n",
        "pt_cut = (e1.Electron_pt > 25) & (e2.Electron_pt > 25)\n",
        "os_cut = (e1.Electron_charge != e2.Electron_charge)\n",
        "id_cut = (e1.Electron_cutBased >= 2) & (e2.Electron_cutBased >= 2)\n",
        "\n",
        "selection = pt_cut & os_cut & id_cut\n",
        "\n",
        "e1_sel = e1[selection]\n",
        "e2_sel = e2[selection]\n",
        "\n",
        "# 5. Build Lorentz 4-vectors\n",
        "p4_e1 = vector.zip({\n",
        "    \"pt\": e1_sel.Electron_pt,\n",
        "    \"eta\": e1_sel.Electron_eta,\n",
        "    \"phi\": e1_sel.Electron_phi,\n",
        "    \"mass\": 0.000511\n",
        "})\n",
        "\n",
        "p4_e2 = vector.zip({\n",
        "    \"pt\": e2_sel.Electron_pt,\n",
        "    \"eta\": e2_sel.Electron_eta,\n",
        "    \"phi\": e2_sel.Electron_phi,\n",
        "    \"mass\": 0.000511\n",
        "})\n",
        "\n",
        "# Reconstruct Z boson 4-vector and extract invariant mass\n",
        "z_boson = p4_e1 + p4_e2\n",
        "m_ee = z_boson.mass\n",
        "\n",
        "# 6. Plot the invariant mass histogram\n",
        "plt.figure(figsize=(9, 6))\n",
        "plt.hist(m_ee, bins=60, range=(60, 120), color='dodgerblue', edgecolor='black', alpha=0.8)\n",
        "plt.axvline(91.1876, color='red', linestyle='--', linewidth=2, label=\"PDG Z Mass (91.2 GeV)\")\n",
        "\n",
        "plt.title(r\"CMS Run 2016G (NanoAODv9) — $Z \\rightarrow e^+ e^-$ Mass Peak\", fontsize=13)\n",
        "plt.xlabel(r\"Dielectron Invariant Mass $m_{ee}$ [GeV]\", fontsize=12)\n",
        "plt.ylabel(\"Events / 1 GeV\", fontsize=12)\n",
        "plt.grid(True, linestyle=\":\", alpha=0.6)\n",
        "plt.legend(fontsize=11)\n",
        "plt.show()\n",
        "print('created in colab')"
      ]
    },
